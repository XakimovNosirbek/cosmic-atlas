{
  "version": 1,
  "catalogs": [
    "tiles/catalogs/named-stars.json",
    "tiles/catalogs/local-group.json",
    "tiles/catalogs/local-volume.json",
    "tiles/catalogs/nebulae-snr.json",
    "tiles/catalogs/messier-ngc.json",
    "tiles/catalogs/black-holes.json",
    "tiles/catalogs/exoplanets.json",
    "tiles/catalogs/pulsars.json",
    "tiles/catalogs/seti.json",
    "tiles/catalogs/dev-placeholder.json"
  ],
  "layers": [
    {
      "id": "stars-gaia",
      "title": "Gaia DR3 stars",
      "path": "tiles/stars-gaia",
      "visible": true,
      "colorMode": "star",
      "credit": "ESA/Gaia/DPAC, Gaia DR3"
    },
    {
      "id": "stars-gaia-preview",
      "title": "Gaia DR3 stars within 100 pc",
      "path": "tiles/stars-gaia-preview",
      "visible": true,
      "colorMode": "star",
      "preview": true,
      "fallbackFor": "stars-gaia",
      "credit": "ESA/Gaia/DPAC, Gaia DR3; finished download chunks only"
    },
    {
      "id": "galaxies-desi",
      "title": "DESI galaxies",
      "path": "tiles/galaxies-desi",
      "visible": true,
      "colorMode": "galaxy",
      "credit": "DESI Collaboration"
    },
    {
      "id": "galaxies-2mrs",
      "title": "2MASS Redshift Survey",
      "path": "tiles/galaxies-2mrs",
      "visible": true,
      "colorMode": "galaxy",
      "credit": "Huchra et al. 2012"
    },
    {
      "id": "galaxies-cf4",
      "title": "Cosmicflows-4 galaxies",
      "path": "tiles/galaxies-cf4",
      "visible": false,
      "colorMode": "galaxy",
      "credit": "Tully et al. 2023, redshift-independent distances"
    },
    {
      "id": "galaxies-sdss",
      "title": "SDSS galaxies and quasars",
      "path": "tiles/galaxies-sdss",
      "visible": true,
      "colorMode": "galaxy",
      "credit": "SDSS DR17, Abdurro'uf et al. 2022; objects already in DESI DR1 removed"
    },
    {
      "id": "galaxies-6dfgs",
      "title": "6dF Galaxy Survey",
      "path": "tiles/galaxies-6dfgs",
      "visible": true,
      "colorMode": "galaxy",
      "credit": "6dFGS DR3, Jones et al. 2009; objects already in DESI, SDSS or 2MRS removed"
    },
    {
      "id": "galaxies-2dfgrs",
      "title": "2dF Galaxy Redshift Survey",
      "path": "tiles/galaxies-2dfgrs",
      "visible": true,
      "colorMode": "galaxy",
      "credit": "2dFGRS, Colless et al. 2001; objects already in DESI, SDSS, 2MRS or 6dFGS removed"
    },
    {
      "id": "galaxies-euclid",
      "title": "Euclid DR1 deep-field spectra",
      "path": "tiles/galaxies-euclid",
      "visible": false,
      "colorMode": "galaxy",
      "credit": "ESA Euclid DR1 (CC BY-NC 3.0 IGO); high-purity NISP redshifts, Euclid Deep Field North only"
    },
    {
      "id": "local-group",
      "title": "Local Group galaxies",
      "path": "tiles/local-group",
      "visible": true,
      "colorMode": "galaxy"
    },
    {
      "id": "local-volume",
      "title": "Local Volume galaxies",
      "path": "tiles/local-volume",
      "visible": true,
      "colorMode": "galaxy",
      "credit": "UNGC, Karachentsev et al. 2013"
    },
    {
      "id": "synthetic-stars",
      "title": "Synthetic stars",
      "path": "tiles/synthetic-stars",
      "visible": true,
      "colorMode": "star",
      "dev": true,
      "fallbackFor": ["stars-gaia", "stars-gaia-preview"]
    },
    {
      "id": "synthetic-galaxies",
      "title": "Synthetic galaxies",
      "path": "tiles/synthetic-galaxies",
      "visible": true,
      "colorMode": "galaxy",
      "dev": true,
      "fallbackFor": "galaxies-desi"
    },
    {
      "id": "milky-way-model",
      "type": "milky-way-model",
      "title": "Milky Way model",
      "visible": true,
      "credit": "Arms: Reid et al. 2019, ApJ 885, 131; R0 = 8.275 kpc, GRAVITY 2021. A model, not data."
    },
    {
      "id": "gaia-sky",
      "type": "sky",
      "title": "Gaia all-sky image",
      "visible": true,
      "image": "sky/gaia_dr3_sky_l9.jpg",
      "imageWebp": "sky/gaia_dr3_sky_l9.webp",
      "preview": "sky/gaia_dr3_sky_l9_lo.jpg",
      "credit": "Gaia DR3 integrated flux (ESA/Gaia/DPAC)"
    }
  ]
}
